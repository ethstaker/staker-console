{
  "name": "staker-console",
  "version": "0.1.0",
  "type": "module",
  "description": "Staker Console",
  "engines": {
    "node": ">=24"
  },
  "license": "GPL-3.0",
  "scripts": {
    "dev": "vite --force",
    "build": "tsc && vite build",
    "start": "serve -s dist",
    "preview": "vite preview",
    "https-preview": "serve dist",
    "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:check": "eslint src --max-warnings=0",
    "ts:check": "tsc --noEmit",
    "ts:check:strict": "tsc --noEmit --skipLibCheck",
    "ts:check:staged": "node scripts/ts-check-staged.js",
    "test:unit": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@chainsafe/ssz": "^1.6.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.0.0",
    "@noble/curves": "^1.9.7",
    "@reown/appkit": "^1.8.22",
    "@reown/appkit-adapter-wagmi": "^1.8.22",
    "@tanstack/react-query": "^5.100.4",
    "bignumber.js": "^11.1.3",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-router-dom": "^7.18.2",
    "wagmi": "^2.15.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^20.19.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "globals": "^17.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.8.1",
    "serve": "^14.1.2",
    "tailwindcss": "^4.2.2",
    "tsc-files": "^1.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.6",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "node scripts/ts-check-staged.js",
      "prettier --write"
    ],
    "src/**/*.{js,jsx,json,css,scss,md}": "prettier --write"
  },
  "keywords": [],
  "overrides": {
    "axios": "^1.18.0",
    "ws": "^8.21.0",
    "uuid": "^14.0.0",
    "unrs-resolver": "1.11.1",
    "@wagmi/connectors": "6.2.0"
  },
  "allowScripts": {
    "keccak@3.0.4": true,
    "utf-8-validate@5.0.10": true,
    "@reown/appkit@1.7.8": true,
    "@reown/appkit@1.8.23": true,
    "bufferutil@4.1.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.3": true
  }
}
